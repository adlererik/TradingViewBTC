//@version=6
indicator("My Super Script", overlay = true, max_labels_count = 200, max_lines_count = 39)

// Price averages use chart bars, as in the original study. Use a 1D Bitcoin
// chart for the intended day counts. Mining averages always use daily data.
const int DAY_MS = 86400000
const string DISPLAY_GROUP = "Display and signals"
const string MINING_GROUP = "Bitcoin mining"
const string DIFFICULTY_GROUP = "Difficulty ribbon"
const string CHANNEL_GROUP = "Logarithmic channel"
const string SAR_GROUP = "Lucid SAR"
const string GUPPY_GROUP = "Guppy in one line"

showLabels = input.bool(true, "Show end labels", group = DISPLAY_GROUP)
labelOffset = input.int(8, "End label offset (bars)", minval = -500, maxval = 500, group = DISPLAY_GROUP)
confirmSignals = input.bool(true, "Confirm price signals at bar close", group = DISPLAY_GROUP)
showHalvings = input.bool(true, "Shade Bitcoin halvings", group = DISPLAY_GROUP)
signalReady = not confirmSignals or barstate.isconfirmed
labelBackground = color.new(color.black, 100)

priceLabel(string caption, float price, color background, bool below, string description = "") =>
    label.new(bar_index, price, caption + "\n" + str.tostring(price, format.mintick),
         yloc = below ? yloc.belowbar : yloc.abovebar,
         style = below ? label.style_label_up : label.style_label_down,
         color = background, textcolor = color.white, size = size.small, tooltip = description)

// 2-Year Moving Average Multiplier
twoYearAverage = ta.sma(close, 730)
twoYearUpper = twoYearAverage * 5.0
priceAnchor = plot(close, "Price fill anchor", display = display.none)
investorLower = plot(twoYearAverage, "2-Year MA", display = display.none)
investorUpper = plot(twoYearUpper, "2-Year MA ×5", display = display.none)
fill(investorLower, priceAnchor, open <= twoYearAverage ? color.new(color.green, 75) : na, title = "2-Year MA lower zone", fillgaps = false)
fill(investorUpper, priceAnchor, open >= twoYearUpper ? color.new(color.red, 75) : na, title = "2-Year MA upper zone", fillgaps = false)
upperBandCross = ta.crossover(close, twoYearUpper)
upperBandSignal = signalReady and upperBandCross
plotshape(upperBandSignal, "2-Year MA ×5 breakout", shape.arrowdown, location.abovebar,
     color.new(color.red, 10), text = "Above\n2Y MA ×5", textcolor = color.red, size = size.small)

// 200 Week Moving Average and 30-bar heatmap
wma200 = ta.sma(close, 1400)
plot(wma200, "200 Week MA", color.white)
plotshape(showLabels ? wma200 : na, "200 WMA end label", shape.labeldown, location.absolute,
     labelBackground, offset = labelOffset, text = "200 WMA", textcolor = color.white, show_last = 1)
wmaDip = ta.crossunder(low, wma200)
wmaDipSignal = signalReady and wmaDip
if wmaDipSignal
    priceLabel("BUY · 200 WMA", low, color.blue, true, "The candle low crossed below the 200 Week MA.")

// Pi Cycle Top and Golden Ratio Multiplier share the 350-bar average.
sma350 = ta.sma(close, 350)
goldenRatio = sma350 * 3.0
piSlow = sma350 * 2.0
piFast = ta.sma(close, 111)
plot(goldenRatio, "Golden Ratio Multiplier (350 MA ×3)", color.yellow)
plot(piSlow, "Pi Cycle Top slow (350 MA ×2)", color.teal)
plot(piFast, "Pi Cycle Top fast (111 MA)", color.yellow)
plotshape(showLabels ? goldenRatio : na, "Golden Ratio end label", shape.labeldown, location.absolute,
     labelBackground, offset = labelOffset, text = "Golden Ratio 2021", textcolor = color.yellow, show_last = 1)
plotshape(showLabels ? piSlow : na, "Pi Cycle slow end label", shape.labeldown, location.absolute,
     labelBackground, offset = labelOffset, text = "Pi Top Slow", textcolor = color.teal, show_last = 1)
plotshape(showLabels ? piFast : na, "Pi Cycle fast end label", shape.labeldown, location.absolute,
     labelBackground, offset = labelOffset, text = "Pi Top Fast", textcolor = color.yellow, show_last = 1)
piCross = ta.crossover(piFast, piSlow)
piSignal = signalReady and piCross
if piSignal
    priceLabel("SELL · Pi Cycle Top", close, color.red, false)

previousWma = wma200[30]
wmaChange = previousWma > 0 ? math.abs(wma200 - previousWma) / previousWma * 100.0 : na
heatColor(float change) =>
    switch
        na(change) => color(na)
        change >= 20 => color.red
        change >= 15 => color.orange
        change >= 10 => color.yellow
        change >= 5 => color.green
        change > 2.5 => color.aqua
        => color.purple

plot(wmaChange, "200 WMA absolute change (%)", display = display.data_window)
plotshape(not na(wmaChange), "200 WMA heatmap", shape.circle, location.abovebar,
     heatColor(wmaChange), size = size.tiny)
var label parabolicLabel = na
var label hyperParabolicLabel = na
if signalReady and piSlow > piFast
    if wmaChange > 13 and wmaChange <= 15
        label.delete(parabolicLabel)
        parabolicLabel := label.new(bar_index, high, "Parabolic\n200 WMA Δ " + str.tostring(wmaChange, "#.0") + "%",
             yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.orange, 25), size = size.tiny)
    if wmaChange > 15 and wmaChange <= 20
        label.delete(hyperParabolicLabel)
        hyperParabolicLabel := label.new(bar_index, high, "Hyper Parabolic\n200 WMA Δ " + str.tostring(wmaChange, "#.0") + "%",
             yloc = yloc.abovebar, style = label.style_label_down, color = color.new(color.red, 25),
             textcolor = color.white, size = size.tiny)

// Difficulty and hash-rate calculations run inside their daily feeds. The one-day
// offset means only completed source days affect the plots and miner crossings.
showDifficulty = input.bool(true, "Show difficulty ribbon", group = MINING_GROUP)
showMinerSignals = input.bool(true, "Show miner signals", group = MINING_GROUP)
difficultySymbol = input.symbol("BCHAIN:DIFF", "Difficulty symbol", group = MINING_GROUP)
hashRateSymbol = input.symbol("BCHAIN:HRATE", "Hash rate symbol", group = MINING_GROUP)
hashShortLength = input.int(30, "Short hash-rate SMA (days)", minval = 1, group = MINING_GROUP)
hashLongLength = input.int(60, "Long hash-rate SMA (days)", minval = 1, group = MINING_GROUP)
difficultyDivisor = input.float(1e9, "Difficulty scale divisor", minval = 1.0, group = DIFFICULTY_GROUP)
diffLength1 = input.int(9, "SMA 1 (days)", minval = 1, group = DIFFICULTY_GROUP)
diffLength2 = input.int(14, "SMA 2 (days)", minval = 1, group = DIFFICULTY_GROUP)
diffLength3 = input.int(25, "SMA 3 (days)", minval = 1, group = DIFFICULTY_GROUP)
diffLength4 = input.int(40, "SMA 4 (days)", minval = 1, group = DIFFICULTY_GROUP)
diffLength5 = input.int(60, "SMA 5 (days)", minval = 1, group = DIFFICULTY_GROUP)
diffLength6 = input.int(90, "SMA 6 (days)", minval = 1, group = DIFFICULTY_GROUP)
diffLength7 = input.int(128, "SMA 7 (days)", minval = 1, group = DIFFICULTY_GROUP)
diffLength8 = input.int(200, "SMA 8 (days)", minval = 1, group = DIFFICULTY_GROUP)

dailyDifficulty() =>
    scaled = close / difficultyDivisor
    [ta.sma(scaled, diffLength1)[1], ta.sma(scaled, diffLength2)[1],
     ta.sma(scaled, diffLength3)[1], ta.sma(scaled, diffLength4)[1],
     ta.sma(scaled, diffLength5)[1], ta.sma(scaled, diffLength6)[1],
     ta.sma(scaled, diffLength7)[1], ta.sma(scaled, diffLength8)[1], time_close[1]]

dailyMinerEvents() =>
    shortAverage = ta.sma(close, hashShortLength)
    longAverage = ta.sma(close, hashLongLength)
    crossedBelow = ta.crossunder(shortAverage, longAverage)
    crossedAbove = ta.crossover(shortAverage, longAverage)
    // Carry the latest matching event so a weekly/monthly bar can show a
    // crossing even if it did not occur on the sampled final daily bar.
    [ta.valuewhen(crossedBelow[1], time, 0), ta.valuewhen(crossedAbove[1], time, 0), time_close[1]]

chartSeconds = timeframe.in_seconds()
dailyLookahead = chartSeconds > 86400 ? barmerge.lookahead_off : barmerge.lookahead_on
[difficulty1, difficulty2, difficulty3, difficulty4, difficulty5, difficulty6, difficulty7, difficulty8, difficultyAsOf] =
     request.security(difficultySymbol, "1D", dailyDifficulty(), lookahead = dailyLookahead, ignore_invalid_symbol = true)
[minerCapitulationTime, minerIncreaseTime, hashRateAsOf] =
     request.security(hashRateSymbol, "1D", dailyMinerEvents(), lookahead = dailyLookahead, ignore_invalid_symbol = true)

plot(showDifficulty ? difficulty1 : na, "Difficulty ribbon 1", color.new(color.red, 50))
plot(showDifficulty ? difficulty2 : na, "Difficulty ribbon 2", color.new(color.orange, 50))
plot(showDifficulty ? difficulty3 : na, "Difficulty ribbon 3", color.new(color.yellow, 50))
plot(showDifficulty ? difficulty4 : na, "Difficulty ribbon 4", color.new(color.green, 50))
plot(showDifficulty ? difficulty5 : na, "Difficulty ribbon 5", color.new(color.aqua, 50))
plot(showDifficulty ? difficulty6 : na, "Difficulty ribbon 6", color.new(color.blue, 50))
plot(showDifficulty ? difficulty7 : na, "Difficulty ribbon 7", color.new(color.teal, 50))
plot(showDifficulty ? difficulty8 : na, "Difficulty ribbon 8", color.new(color.purple, 50))

eventInBar(int eventTime) =>
    not na(eventTime) and not na(time_close) and eventTime >= time and eventTime < time_close

minerCapitulation = showMinerSignals and barstate.isconfirmed and eventInBar(minerCapitulationTime)
minerIncrease = showMinerSignals and barstate.isconfirmed and eventInBar(minerIncreaseTime)
plotshape(minerCapitulation, "Miner Capitulation", shape.arrowdown, location.abovebar,
     color.new(color.red, 10), text = "Miner\nCapitulation", textcolor = color.red, size = size.small)
plotshape(minerIncrease, "Miner Increase", shape.arrowup, location.belowbar,
     color.new(color.blue, 10), text = "Miner\nIncrease", textcolor = color.rgb(33, 150, 243), size = size.small)

var table miningStatus = table.new(position.top_right, 1, 2)
feedStatus(int asOf, string name) =>
    if na(asOf)
        name + ": no daily data"
    else if time - asOf > 7 * DAY_MS
        name + ": last confirmed " + str.format_time(asOf, "yyyy-MM-dd", "UTC")
    else
        ""

if barstate.islast
    difficultyStatus = showDifficulty ? feedStatus(difficultyAsOf, "Mining difficulty") : ""
    hashStatus = showMinerSignals ? feedStatus(hashRateAsOf, "Hash rate") : ""
    table.clear(miningStatus, 0, 0, 0, 1)
    if difficultyStatus != ""
        table.cell(miningStatus, 0, 0, difficultyStatus, text_color = color.white, bgcolor = color.new(color.orange, 60))
    if hashStatus != ""
        table.cell(miningStatus, 0, 1, hashStatus, text_color = color.white, bgcolor = color.new(color.orange, 60))

// Woo Top Cap proxy. Its denominator includes elapsed days before loaded chart
// history, so this copy of the original formula is intended for the daily chart.
topCapMultiple = input.float(35, "Multiplier", minval = 0.01, group = "Woo Top Cap")
genesisDate = input.time(timestamp("03 Jan 2009 00:00 +0000"), "Bitcoin launch date", group = "Woo Top Cap")
var int daysBeforeHistory = math.floor(time / float(DAY_MS)) - math.floor(genesisDate / float(DAY_MS))
topCapCount = daysBeforeHistory + bar_index + 1
totalClosingPrices = ta.cum(close)
topCap = topCapCount > 0 ? topCapMultiple * totalClosingPrices / topCapCount : na
plot(topCap, "Woo Top Cap proxy", color.purple, linewidth = 2)
plotshape(showLabels ? topCap : na, "Woo Top Cap end label", shape.labeldown, location.absolute,
     labelBackground, offset = labelOffset, text = "Woo Top Cap", textcolor = color.purple, show_last = 1)

// Halving days in UTC. Shade each candle whose time span overlaps the window.
halvingWindow(int halvingDay) =>
    time < halvingDay + 3 * DAY_MS and nz(time_close, time + 1) > halvingDay - 2 * DAY_MS

halvingBar = halvingWindow(timestamp("28 Nov 2012 00:00 +0000")) or
     halvingWindow(timestamp("09 Jul 2016 00:00 +0000")) or
     halvingWindow(timestamp("11 May 2020 00:00 +0000")) or
     halvingWindow(timestamp("20 Apr 2024 00:00 +0000"))
bgcolor(showHalvings and halvingBar ? color.new(color.red, 80) : na, title = "Bitcoin halving window")

// Logarithmic price channel. Interpolate Fibonacci levels in log space.
curveTheme = input.string("Dark", "Chart theme", options = ["Dark", "Light"], group = CHANNEL_GROUP)
showFibs = input.bool(false, "Show additional Fibonacci levels", group = CHANNEL_GROUP)
showProjections = input.bool(true, "Show curve projections", group = CHANNEL_GROUP)
highIntercept = input.float(1.06930947, "Top curve intercept", step = 0.001, group = CHANNEL_GROUP)
highSlope = input.float(0.00076, "Top curve slope", step = 0.00001, group = CHANNEL_GROUP)
lowIntercept = input.float(-3.0269716, "Bottom curve intercept", step = 0.001, group = CHANNEL_GROUP)
lowSlope = input.float(0.001329, "Bottom curve slope", step = 0.00001, group = CHANNEL_GROUP)
const int CHANNEL_ORIGIN = 1279670400000

logChannel(int atTime) =>
    day = atTime < CHANNEL_ORIGIN ? 3.0 : (atTime - CHANNEL_ORIGIN) / float(DAY_MS)
    weight = (math.log10(day + 10) * day * day - day) / 30000
    logWeight = day > 2 ? math.log(weight) : na
    [logWeight + lowIntercept + lowSlope * day, logWeight + highIntercept + highSlope * day]

channelLevel(float lowerLog, float upperLog, float ratio) =>
    math.exp(lowerLog + (upperLog - lowerLog) * ratio)

[lowerLog, upperLog] = logChannel(time)
channelHigh = math.exp(upperLog)
channelLow = math.exp(lowerLog)
channelMid = channelLevel(lowerLog, upperLog, 0.5)
channelColor = curveTheme == "Dark" ? color.white : color.black
fibColor = color.new(channelColor, 50)
plot(channelHigh, "Log channel top", channelColor)
plot(channelMid, "Log channel middle", channelColor)
plot(channelLow, "Log channel bottom", channelColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.9098) : na, "Log channel 90.98%", fibColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.8541) : na, "Log channel 85.41%", fibColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.7639) : na, "Log channel 76.39%", fibColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.618) : na, "Log channel 61.80%", fibColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.382) : na, "Log channel 38.20%", fibColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.2361) : na, "Log channel 23.61%", fibColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.1459) : na, "Log channel 14.59%", fibColor)
plot(showFibs ? channelLevel(lowerLog, upperLog, 0.0902) : na, "Log channel 9.02%", fibColor)

const int PROJECTION_SEGMENTS = 13
projectionDays = switch
    timeframe.ismonthly => 365
    timeframe.isweekly => 182
    timeframe.isdaily => 91
    timeframe.isminutes and chartSeconds >= 3600 => 7
    => 0

// Reuse the same lines each time the chart updates. Fixed calendar intervals
// keep a gap between traded bars from lengthening the projection.
var array<line> projectionLines = array.new<line>()
if barstate.isfirst and showProjections and projectionDays > 0
    for index = 0 to PROJECTION_SEGMENTS * 3 - 1
        projectionLines.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = channelColor))

updateSegment(line segment, int start, float startPrice, int finish, float finishPrice) =>
    line.set_xy1(segment, start, startPrice)
    line.set_xy2(segment, finish, finishPrice)

if barstate.islast and array.size(projectionLines) > 0
    for index = 0 to PROJECTION_SEGMENTS - 1
        segmentStart = time + projectionDays * DAY_MS * index
        segmentEnd = segmentStart + projectionDays * DAY_MS
        [startLow, startHigh] = logChannel(segmentStart)
        [endLow, endHigh] = logChannel(segmentEnd)
        lineIndex = index * 3
        updateSegment(projectionLines.get(lineIndex), segmentStart, math.exp(startLow), segmentEnd, math.exp(endLow))
        updateSegment(projectionLines.get(lineIndex + 1), segmentStart, channelLevel(startLow, startHigh, 0.5),
             segmentEnd, channelLevel(endLow, endHigh, 0.5))
        updateSegment(projectionLines.get(lineIndex + 2), segmentStart, math.exp(startHigh), segmentEnd, math.exp(endHigh))

channelLowCross = ta.crossunder(low, channelLow)
channelHighCross = ta.crossover(high, channelHigh)
channelLowSignal = signalReady and channelLowCross
channelHighSignal = signalReady and channelHighCross
if channelLowSignal
    priceLabel("BUY · Log Channel", low, color.green, true)
if channelHighSignal
    priceLabel("SELL · Log Channel", high, color.red, false)

// Lucid SAR by Casey Bowman (2019). Source: https://github.com/casey-bowman/sar
// MIT License
//
// Copyright (c) 2019 Casey Bowman
// Permission is hereby granted, free of charge, to any person obtaining a copy
// of this software and associated documentation files (the "Software"), to deal
// in the Software without restriction, including without limitation the rights
// to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
// copies of the Software, and to permit persons to whom the Software is
// furnished to do so, subject to the following conditions:
// The above copyright notice and this permission notice shall be included in all
// copies or substantial portions of the Software.
// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
// IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
// AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
// LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
// OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
// SOFTWARE.
sarInitial = input.float(0.00285714, "Initial acceleration", minval = 0, group = SAR_GROUP)
sarIncrement = input.float(0.0014, "Acceleration step", minval = 0, group = SAR_GROUP)
sarMaximum = input.float(0.2, "Maximum acceleration", minval = 0, group = SAR_GROUP)

lucidSar(float initial, float increment, float maximum) =>
    bool uptrend = true
    bool reversed = false
    float extreme = high
    float acceleration = initial
    float sar = low

    // Preserve Lucid SAR's original acceleration order and reversal rules.
    if not na(sar[1])
        uptrend := uptrend[1]
        extreme := uptrend ? math.max(high, extreme[1]) : math.min(low, extreme[1])
        acceleration := reversed[1] ? initial : acceleration[1]
        if not reversed[1] and extreme != extreme[1]
            acceleration := math.min(maximum, acceleration + increment)
        sar := sar[1] + acceleration * (extreme - sar[1])
        if uptrend
            sar := math.min(sar, low[1], nz(low[2], low[1]))
            if sar > low
                uptrend := false
                reversed := true
                sar := math.max(high, extreme[1])
                extreme := math.min(low, low[1])
        else
            sar := math.max(sar, high[1], nz(high[2], high[1]))
            if sar < high
                uptrend := true
                reversed := true
                sar := math.min(low, extreme[1])
                extreme := math.max(high, high[1])
    sar

plot(lucidSar(sarInitial, sarIncrement, sarMaximum), "Lucid SAR", color.blue, linewidth = 2, style = plot.style_cross)

// Guppy: draw the slowest EMA and color it by the order of the six averages.
guppy1 = ta.ema(close, input.int(30, "EMA 1", minval = 1, group = GUPPY_GROUP))
guppy2 = ta.ema(close, input.int(35, "EMA 2", minval = 1, group = GUPPY_GROUP))
guppy3 = ta.ema(close, input.int(40, "EMA 3", minval = 1, group = GUPPY_GROUP))
guppy4 = ta.ema(close, input.int(45, "EMA 4", minval = 1, group = GUPPY_GROUP))
guppy5 = ta.ema(close, input.int(50, "EMA 5", minval = 1, group = GUPPY_GROUP))
guppy6 = ta.ema(close, input.int(60, "EMA 6", minval = 1, group = GUPPY_GROUP))
guppyUp = guppy1 > guppy2 and guppy2 > guppy3 and guppy3 > guppy4 and guppy4 > guppy5 and guppy5 > guppy6
guppyDown = guppy1 < guppy2 and guppy2 < guppy3 and guppy3 < guppy4 and guppy4 < guppy5 and guppy5 < guppy6
plot(guppyDown ? na : guppy6, "Guppy in one line", guppyUp ? color.lime : color.orange, style = plot.style_cross)
plotshape(showLabels ? guppy6 : na, "Guppy end label", shape.labeldown, location.absolute,
     labelBackground, offset = labelOffset, text = "Guppy in 1 line", textcolor = color.green, show_last = 1)

// Expose the chart events in TradingView's Create Alert dialog.
alertcondition(upperBandSignal, "2-Year MA ×5 breakout", "{{ticker}} crossed above the 2-Year MA ×5 band.")
alertcondition(wmaDipSignal, "200 WMA dip", "{{ticker}} low crossed below the 200 Week MA.")
alertcondition(piSignal, "Pi Cycle Top", "{{ticker}} fast Pi Cycle average crossed above the slow average.")
alertcondition(channelLowSignal, "Log channel low break", "{{ticker}} low crossed below the logarithmic channel.")
alertcondition(channelHighSignal, "Log channel high break", "{{ticker}} high crossed above the logarithmic channel.")
alertcondition(minerCapitulation, "Miner Capitulation", "Bitcoin short daily hash-rate SMA crossed below the long SMA.")
alertcondition(minerIncrease, "Miner Increase", "Bitcoin short daily hash-rate SMA crossed above the long SMA.")
