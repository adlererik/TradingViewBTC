halving_2 = timestamp(2016,7,9,0,0)
halving_3 = timestamp(2020,5,11,0,0)
halving_4 = timestamp(2024,3,11,0,0) // projected! https://www.bitcoinclock.com/
h1_range = time >= halving_1 - 2*(24*60*60*1000) and time <= halving_1 + 2*(24*60*60*1000) //adds 2 day either side for chart visibility
h2_range = time >= halving_2 - 2*(24*60*60*1000) and time <= halving_2 + 2*(24*60*60*1000) //adds 2 day either side for chart visibility
h3_range = time >= halving_3 - 2*(24*60*60*1000) and time <= halving_3 + 2*(24*60*60*1000) //adds 2 day either side for chart visibility
h4_range = time >= halving_4 - 2*(24*60*60*1000) and time <= halving_4 + 2*(24*60*60*1000) //adds 2 day either side for chart visibility
bgcolor(h1_range and plot_halvings? color.red : na, transp = 20)
bgcolor(h2_range and plot_halvings? color.red : na, transp = 20)
bgcolor(h3_range and plot_halvings? color.red : na, transp = 20)
bgcolor(h4_range and plot_halvings? color.red : na, transp = 20)
