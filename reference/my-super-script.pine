//@version=4
study("My Super Script", overlay = true)
//2 year Long timeframe investor tool to identify under/oversold price periods
//When price area turns red the market is unstable. When green start thinking about buying.
twoyearclose = sma(close, 730)
twoyearclosex5 = twoyearclose * 5
candles = plot(close, "", color.new(color.white, 100), linewidth=1)
avgPlot=plot(twoyearclose, '', color.new(color.white, 100), linewidth = 1)
avgMultPlot=plot(twoyearclosex5, '', color.new(color.white, 100), linewidth = 1)
fill(avgMultPlot, candles, color = open < twoyearclosex5 ? na : color.new(color.red, 75))
fill(avgPlot, candles, color = open  > twoyearclose ? na : color.new(color.green, 75))
data1 = crossover (close, twoyearclosex5 * 1.0)
plotshape(data1, color=color.new(color.red, 10), style=shape.arrowdown, location = location.abovebar, size = size.small, text="Over\nSold")
//BTC has never dropped under the 200 week MA.
// If BTC dips down to the 200 week MA. Buy here.
avg200week = sma(close, 1400)
plot(avg200week, "200 Week MA", color.white, linewidth=1)
showlabels = input(title="Show Labels ?", type=input.bool, defval=true)
offset_val = input(title="Label Offset", type=input.integer, defval=8)
plotshape(showlabels ? avg200week : na, style=shape.labeldown, location=location.absolute, color=color.purple,  textcolor=color.new(color.white,0), show_last=1, text="200 WMA",  offset = offset_val, transp=100, title="200 Week MA")
if crossover (avg200week, low)
    l = label.new(bar_index, na)
    label.set_text(l, text="BUY\n" + tostring(low))
    label.set_size(l, size.small)
    label.set_color(l, color.new(color.blue, 0))
    label.set_yloc(l, yloc.belowbar)
    label.set_style(l, label.style_labelup)
    label.set_tooltip(l, "The 200 week moving avg has been crossed. Has only happened once.")
//The Golden Ratio Multiplier
//Each ATH top should kiss a line that is one down from the last ATH.
//The next ATH should kiss the red line (350DMA * 3)
sma350= sma(close, 350)
sma111 = sma(close, 111)
//plot(sma111, "SMA (close, 111)", color.lime, linewidth=3)
//plot(sma350, "SMA (close, 350)",  color.orange, linewidth=1)
//plot(sma350 * 1.618, "SMA350 x Golden Ratio", color.green, linewidth=2)
//plot(sma350 * 2, "2024 ATH x 2", color.green, linewidth=1)
//plotshape(showlabels ? sma350 * 2: na, style=shape.labeldown, location=location.absolute, color=color.purple,  textcolor=color.new(color.green,0), show_last=1, text="Golden Ratio 2024",  offset = offset_val, transp=100, title="Golden Ratio 2024")
plot(sma350  * 3, "2021 ATH - Fib x3", color.yellow, linewidth=1)
plotshape(showlabels ? sma350 * 3: na, style=shape.labeldown, location=location.absolute, color=color.purple,  textcolor=color.new(color.yellow,0), show_last=1, text="Golden Ratio 2021",  offset = offset_val, transp=100, title="Golden Ratio")
//plot(sma350  * 5, "2017 ATH - Fib x5", color.blue, linewidth=1)
//plotshape(showlabels ? sma350 * 5: na, style=shape.labeldown, location=location.absolute, color=color.purple,  textcolor=color.new(color.blue,0), show_last=1, text="Golden Ratio 2017",  offset = offset_val, transp=100, title="Golden Ratio 2017")
//plot(sma350  * 8, "2013 ATH - Fib x8", color.teal, linewidth=1)
//plot(sma350  * 13, "SMA350 x 13", color.aqua, linewidth=1)
//plot(sma350  * 21, "SMA x 21", color.teal, linewidth=1)
//Uses Pi Cyclic top to signal the ATH exits
sma350pi= sma(close, 350)
sma111pi = sma(close, 111)
plot(sma350pi * 2, "pi cyclic slow", color.teal, linewidth=1)
plotshape(showlabels ? sma350pi * 2: na, style=shape.labeldown, location=location.absolute, color=color.purple,  textcolor=color.new(color.teal,0), show_last=1, text="Pi top Slow",  offset = offset_val, transp=100, title="Pi Cyclic top")
plot(sma111pi, "pi cyclic fast", color.yellow, linewidth=1)
plotshape(showlabels ? sma111pi: na, style=shape.labeldown, location=location.absolute, color=color.purple,  textcolor=color.new(color.yellow,0), show_last=1, text="Pi top Fast",  offset = offset_val, transp=100, title="Cyclic Pi")
if crossunder (sma350pi * 2, sma111pi)
    l = label.new(bar_index, na)
    label.set_text(l, text="SELL \n Pi Cycle Top \n" + tostring(close))
    label.set_size(l, size.small)
    label.set_color(l, color.new(color.red, 0))
    label.set_yloc(l, yloc.abovebar)
    label.set_style(l, label.style_labeldown)
//Heatmap 200 Week Moving Average by Plan B
//Historically, when we see orange and red dots assigned to the price chart,
//this has been a good time to sell Bitcoin as the market overheats. Periods
// where the price dots are purple and close to the 200 week MA have
// historically been good times to buy.
pre4weeks = sma(close, 1400)[30]
now = sma(close, 1400)
delta = pre4weeks - now
deltaabs = abs(delta)
pre = (deltaabs / pre4weeks)*100
heatcolor = (pre >= 20 ? color.red : pre >= 15 ? color.orange : pre >= 10 ? color.yellow : pre >= 5 ? color.green : pre > 2.5 ? color.aqua : pre <= 2.5 ? color.purple : na)
plot(pre, "testing", heatcolor, linewidth=3)
plotshape(pre, style=shape.circle, color=heatcolor)
plotshape(showlabels ? pre: na, style=shape.labeldown, location=location.absolute, color=color.purple,  textcolor=color.new(color.green,0), show_last=1, text="Heatmap 200 WMA - Plan B",  offset = offset_val, transp=100, title="Heatmap")
if pre > 13 and pre <= 15 and sma350pi * 2 > sma111pi
    l = label.new(bar_index, na)
    label.set_text(l, text="Parabolic\n15%\n 200 WMA Delta")
    label.set_size(l, size.tiny)
    label.set_color(l, color.new(color.orange, 25))
    label.set_yloc(l, yloc.abovebar)
    label.set_style(l, label.style_labeldown)
    label.delete(l[1])
if pre > 15 and pre <= 20 and sma350pi * 2 > sma111pi
    l = label.new(bar_index, na)
    label.set_text(l, text="Hyper\nParabolic\n20%\n 200 WMA Delta")
    label.set_size(l, size.tiny)
    label.set_color(l, color.new(color.red, 25))
    label.set_yloc(l, yloc.abovebar)
    label.set_style(l, label.style_labeldown)
    label.delete(l[1])
