live_HR_long = security("QUANDL:BCHAIN/HRATE", "D", sma(close,len_l),gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
capitulation = crossover (live_HR_long, live_HR_short)
plotshape(capitulation, color=color.new(color.red, 10), style=shape.arrowdown, location = location.abovebar, size = size.small, text="Miner\nCapitulation")
hashIncrease = crossunder (live_HR_long, live_HR_short)
plotshape(hashIncrease, color=color.new(color.blue, 10), style=shape.arrowup, location = location.belowbar, size = size.small, text="Miner\nIncrease")
// HALVINGS
